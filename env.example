# ============================================
# AI Security Research OS - Configuration File
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/security_os
DATABASE_ECHO=False

# ============================================
# LLM Configuration - Choose One Provider
# ============================================

# Active LLM Provider
# Options: "ollama", "claude", "gemini", "openai", "nvidia"
ACTIVE_LLM=ollama

# -------- Ollama (Local) --------
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=mistral
# Available models: mistral, llama2, neural-chat, openchat

# -------- Claude (API) --------
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
# Models: claude-3-5-sonnet, claude-3-opus, claude-3-haiku

# -------- Gemini (API) --------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# Models: gemini-2.0-flash, gemini-1.5-pro

# -------- OpenAI (API) --------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
# Models: gpt-4, gpt-4-turbo, gpt-3.5-turbo

# -------- Nvidia (API) --------
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1

# ============================================
# Token & Context Settings
# ============================================
MAX_TOKENS=8000
CONTEXT_WINDOW=32000

# ============================================
# Agent Settings
# ============================================
AGENT_TIMEOUT=300
MAX_RETRIES=3

# ============================================
# Security Settings
# ============================================
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_encryption_key_here

# ============================================
# Report Settings
# ============================================
REPORT_FORMAT=pdf
REPORT_STORAGE_PATH=./reports

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FILE=app.log

# ============================================
# CORS Settings
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080
